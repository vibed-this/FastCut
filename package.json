{
  "name": "fastcut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "dist": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "build:cli": "esbuild cli/main.ts --bundle --platform=node --format=esm --external:ffmpeg-static --outfile=out/cli/fastcut-cli.js",
    "cli": "node out/cli/fastcut-cli.js"
  },
  "dependencies": {
    "antd": "^6.6.5",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3",
    "p-limit": "^7.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xgplayer": "^3.0.26",
    "xgplayer-hls": "^3.0.26"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.fastcut.app",
    "productName": "FastCut",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/p-limit/**/*",
      "node_modules/yocto-queue/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "notarize": false
    }
  }
}
