[
  {
    "label": "Tauri Dev",
    "command": "export NO_PROXY=\"$NO_PROXY,localhost,127.0.0.1\"; npm run tauri dev",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },
  {
    "label": "Frontend: build",
    "command": "npm run build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Build Tauri backend (cargo)",
    "command": "cargo build",
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Rust: check",
    "command": "cargo check",
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Rust: test",
    "command": "cargo test",
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "reveal": "no_focus",
    "hide": "on_success"
  }
]
